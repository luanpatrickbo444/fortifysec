# /etc/nginx/sites-available/fortify-range
# Use um certificado TLS válido para range.fortifysec.com.br.
server {
    listen 443 ssl http2;
    server_name range.fortifysec.com.br;

    ssl_certificate     /etc/letsencrypt/live/range.fortifysec.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/range.fortifysec.com.br/privkey.pem;

    client_max_body_size 128k;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
    }
}
