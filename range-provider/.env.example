# FortifySec Range Provider
PORT=8787
PROVIDER_API_KEY=troque-por-um-segredo-longo-e-aleatorio
PUBLIC_BASE_URL=https://range.fortifysec.com.br

# WireGuard - acesso dos alunos
WG_INTERFACE=wg0
WG_ENDPOINT=range.fortifysec.com.br:51820
# Opcional: se vazio, o provider usa `wg show wg0 public-key`
WG_SERVER_PUBLIC_KEY=
WG_CLIENT_DNS=

STATE_FILE=./data/state.json
LABS_FILE=./labs.json
MAX_TTL_MINUTES=240

# Interface da VM gateway usada para alcançar a VNet do Azure.
# Em Ubuntu no Azure costuma ser eth0, mas confirme com: ip route get 1.1.1.1
AZURE_EGRESS_INTERFACE=eth0

# Azure VM Provider
# Recomendado: o fortify-range-01 usa Managed Identity; NÃO coloque client secret aqui.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-fortifysec-range
AZURE_LOCATION=brazilsouth

# IDs completos dos recursos Azure. Exemplo:
# /subscriptions/<SUB>/resourceGroups/rg-fortifysec-range/providers/Microsoft.Network/virtualNetworks/vnet-fortifysec-range/subnets/snet-labs
AZURE_LAB_SUBNET_ID=
# NSG dedicado aos Labs. Obrigatório no adapter para evitar criar VM sem isolamento de rede.
AZURE_LAB_NSG_ID=

AZURE_VM_SIZE_DEFAULT=Standard_B2s
AZURE_OS_DISK_SKU=StandardSSD_LRS
AZURE_VM_NAME_PREFIX=fortify-lab
AZURE_ADMIN_USERNAME=fortifyadmin
# Somente chave PÚBLICA SSH. Nunca coloque chave privada aqui.
AZURE_SSH_PUBLIC_KEY=
# Só será necessário quando adicionarmos Labs Windows generalizados.
AZURE_WINDOWS_ADMIN_PASSWORD=

# Espera opcional pelo ready_port do Lab após o provisionamento.
AZURE_READY_TIMEOUT_SECONDS=120
# Sweep de VMs FortifySec expiradas/orfãs (5 min por padrão).
AZURE_SWEEP_INTERVAL_MS=300000
