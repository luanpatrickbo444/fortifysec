# FortifySec Range Provider - Google Cloud production
PORT=8787
LISTEN_HOST=127.0.0.1
PROVIDER_API_KEY=troque-por-um-segredo-longo-e-aleatorio
PUBLIC_BASE_URL=https://range.fortifysec.com.br
STATE_FILE=./data/state.json
LABS_FILE=./labs.gcp.json
MAX_TTL_MINUTES=240
MAX_ACTIVE_SESSIONS=100
MAX_SESSIONS_PER_USER=2

# WireGuard. O gateway GCP recebe o tráfego dos alunos.
WG_INTERFACE=wg0
WG_ENDPOINT=range.fortifysec.com.br:51820
WG_SERVER_PUBLIC_KEY=
WG_CLIENT_DNS=
# Opcional; se vazio o provider descobre a interface com `ip route get TARGET_IP`.
GCP_EGRESS_INTERFACE=

# Google Cloud Compute Engine
GCP_PROJECT_ID=
GCP_ZONE=southamerica-east1-b
GCP_NETWORK=global/networks/fortify-range
GCP_SUBNETWORK=regions/southamerica-east1/subnetworks/fortify-labs
GCP_MACHINE_TYPE_DEFAULT=e2-small
GCP_DISK_TYPE_DEFAULT=pd-balanced
GCP_DISK_SIZE_GB_DEFAULT=20
GCP_VM_NAME_PREFIX=fortify-lab
GCP_TARGET_TAG=fortify-lab
GCP_READY_TIMEOUT_SECONDS=180
GCP_SWEEP_INTERVAL_MS=300000

# Autenticação GCP:
# Em produção NÃO use chave JSON no disco. O gateway deve usar a service account anexada à VM
# e Application Default Credentials automaticamente.
