[Unit]
Description=FortifySec Range Provider
After=network-online.target docker.service wg-quick@wg0.service
Wants=network-online.target docker.service wg-quick@wg0.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/fortify-range
EnvironmentFile=/opt/fortify-range/.env
ExecStart=/usr/bin/node /opt/fortify-range/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/fortify-range/data /var/run/docker.sock

[Install]
WantedBy=multi-user.target
