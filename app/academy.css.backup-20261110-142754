:13px 14px;background:#0c0d11;border:1px solid #363842;color:#fff;font:inherit;border-radius:3px}.academy-input:focus{outline:1px solid #ef3141}.academy-check{display:flex!important;align-items:center;gap:9px!important}.academy-check input{accent-color:#ed2938}.academy-actions{display:flex;gap:10px}.academy-btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;background:#e52938;color:#fff;border:0;padding:14px 19px;font-weight:700;cursor:pointer;text-decoration:none;font-size:13px}.academy-btn:disabled{opacity:.5}.academy-actions>button:not(.academy-btn),.academy-item button{background:#292a31;border:0;color:#e5e5e8;padding:11px 15px;cursor:pointer}.academy-item{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:20px 0;border-bottom:1px solid #30323a}.academy-item h3{font-size:17px;margin:7px 0}.academy-item small{color:#f43d4c;font-size:10px;letter-spacing:.07em}.academy-item p{font-size:12px;color:#9da0aa}.academy-item>div:last-child{display:flex;gap:7px}.academy-alert{border-left:3px solid #f13240;background:#25181d;padding:13px 17px;margin-bottom:20px}.academy-upload{border:1px dashed #656774;padding:17px;cursor:pointer}.academy-upload input{width:100%;font-size:12px}.academy-login{max-width:430px;margin:11vh auto;background:#18191e;padding:38px;border:1px solid #33353c}.academy-login h1{font-size:27px;margin:16px 0}.academy-login p{color:#adb0ba;line-height:1.5}.academy-login form{display:grid;gap:14px;margin-top:26px}.academy-back{display:inline-flex;align-items:center;gap:9px;color:#c5c7ce;background:none;border:0;cursor:pointer;text-decoration:none;margin-bottom:25px}.academy-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.academy-course{text-align:left;border:1px solid #30313b;background:#18191e;color:#fff;cursor:pointer;padding:0;overflow:hidden}.academy-course:hover{border-color:#f03442}.academy-cover{height:175px;background:linear-gradient(130deg,#24252b,#4e1720);background-size: