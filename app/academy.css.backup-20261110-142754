/* FortifySec AI Tutor */
.fs-tutor {
  display: flex;
  flex-direction: column;
  min-height: 480px;
  max-height: 650px;
  background: #10141d;
  border: 1px solid #2b3442;
  border-radius: 16px;
  overflow: hidden;
  color: #f5f7fb;
}

.fs-tutor-header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 18px;
  border-bottom: 1px solid #29313e;
}

.fs-tutor-header h3 {
  margin: 0;
  font-size: 17px;
}

.fs-tutor-header p {
  display: flex;
  align-items: center;
  gap: 6px;
  margin: 5px 0 0;
  color: #a4adbc;
  font-size: 12px;
}

.fs-tutor-avatar {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: #e72834;
  color: white;
}

.fs-tutor-lesson {
  display: flex;
  flex-direction: column;
  gap: 5px;
  padding: 13px 18px;
  background: #181e29;
  font-size: 13px;
}

.fs-tutor-lesson strong {
  color: #f36a73;
}

.fs-tutor-lesson span {
  color: #d9e0eb;
}

.fs-tutor-messages {
  flex: 1;
  min-height: 220px;
  overflow-y: auto;
  padding: 18px;
}

.fs-tutor-welcome {
  text-align: center;
  padding: 45px 10px;
  color: #aab4c4;
}

.fs-tutor-welcome h4 {
  margin: 12px 0 8px;
  color: white;
}

.fs-tutor-welcome p {
  font-size: 13px;
  line-height: 1.6;
}

.fs-tutor-message {
  display: flex;
  align-items: flex-start;
  gap: 9px;
  margin-bottom: 17px;
}

.fs-tutor-message.user {
  flex-direction: row-reverse;
}

.fs-tutor-message-icon {
  display: grid;
  place-items: center;
  flex-shrink: 0;
  width: 29px;
  height: 29px;
  border-radius: 9px;
  background: #273040;
}

.fs-tutor-message.user .fs-tutor-message-icon {
  background: #e72834;
}

.fs-tutor-bubble {
  max-width: 86%;
  padding: 12px 14px;
  border-radius: 12px;
  background: #202938;
  font-size: 13px;
  line-height: 1.7;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.fs-tutor-message.user .fs-tutor-bubble {
  background: #8e2029;
}

.fs-tutor-form {
  display: flex;
  align-items: flex-end;
  gap: 10px;
  padding: 14px;
  border-top: 1px solid #29313e;
}

.fs-tutor-form textarea {
  flex: 1;
  min-width: 0;
  resize: none;
  border: 1px solid #384354;
  border-radius: 10px;
  background: #19212d;
  color: white;
  padding: 11px;
  font: inherit;
  font-size: 13px;
  outline: none;
}

.fs-tutor-form textarea:focus {
  border-color: #e72834;
}

.fs-tutor-form button {
  display: grid;
  place-items: center;
  flex-shrink: 0;
  width: 42px;
  height: 42px;
  border: 0;
  border-radius: 10px;
  background: #e72834;
  color: white;
  cursor: pointer;
}

.fs-tutor-form button:disabled {
  opacity: .45;
  cursor: not-allowed;
}

.fs-tutor-footer {
  padding: 0 14px 13px;
  color: #8793a5;
  font-size: 11px;
  text-align: center;
}
