/* Business model and standalone information pages */
.business-model{background:#f4f4f2;color:#151515}
.model-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:38px}
.model-card{background:#fff;border:1px solid #dededb;padding:38px;min-height:350px;display:flex;flex-direction:column;align-items:flex-start;gap:15px}
.model-card-company{background:#171719;color:#fff;border-color:#171719}
.model-card .model-icon{width:56px;height:56px;display:grid;place-items:center;background:#ed1c24;color:white}
.model-card h3{font-size:clamp(25px,3vw,38px);line-height:1.12;letter-spacing:-1px}
.model-card p{line-height:1.7;opacity:.77;max-width:480px;flex:1}
.model-card .text-link{margin-top:10px}
.privacy-note{display:flex;align-items:flex-start;gap:12px;padding:22px 0;font-size:14px;line-height:1.65;opacity:.78}
.privacy-note svg{flex-shrink:0;margin-top:3px}
.info-page{min-height:100vh;background:#101012;color:#f8f8f8;padding:88px 0 110px}
.info-page .container{max-width:1080px}
.info-page .back{display:inline-flex;align-items:center;gap:9px;color:#f5f5f5;text-decoration:none;margin-bottom:55px;font-size:13px;letter-spacing:.08em}
.info-page .overline{color:#ff4149}
.info-page h1{font-size:clamp(42px,7vw,88px);line-height:1.03;letter-spacing:-.055em;margin:16px 0 25px}
.info-page .lead{font-size:clamp(17px,2vw,22px);color:#bcbcc2;line-height:1.65;max-width:780px}
.info-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:55px 0}
.info-card{background:#1d1d21;border:1px solid #303036;padding:27px;display:flex;flex-direction:column;gap:16px}
.info-card svg{color:#ff4149}
.info-card h2{font-size:23px;line-height:1.2}
.info-card p{color:#bcbcc2;font-size:14px;line-height:1.7;flex:1}
.info-card .price{font-size:28px;font-weight:800;color:#fff}
.info-card .price small{font-size:12px;color:#aaa}
.info-actions{display:flex;gap:12px;flex-wrap:wrap;margin:35px 0}
.info-actions a{display:inline-flex;align-items:center;gap:10px;background:#ed1c24;color:#fff;padding:15px 22px;font-weight:700;text-decoration:none}
.info-actions a.secondary{background:transparent;border:1px solid #555}
.info-section{padding:30px 0;border-top:1px solid #34343b}
.info-section h2{font-size:27px;margin-bottom:15px}
.info-section p,.info-section li{color:#c4c4c9;line-height:1.8}
.info-section ul{padding-left:20px}
@media(max-width:800px){.model-grid,.info-grid{grid-template-columns:1fr}.model-card{min-height:0}.info-page{padding-top:45px}}
