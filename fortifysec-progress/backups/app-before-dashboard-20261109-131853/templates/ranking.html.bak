{% extends 'base.html' %}{% block content %}<div class="eyebrow">FortifySec Progress</div><h1>Ranking da Arena</h1><p class="lead">Classificação independente por XP obtido em laboratórios concluídos.</p><div class="panel"><table><thead><tr><th>Posição</th><th>Participante</th><th>Nível</th><th>Labs</th><th>XP</th></tr></thead><tbody>{% for user in users %}<tr><td>#{{ loop.index }}</td><td>{{ user.student }}</td><td><span class="pill">{{ user.level }}</span></td><td>{{ user.labs|length }}</td><td class="xp">{{ '{:,}'.format(user.xp).replace(',', '.') }} XP</td></tr>{% else %}<tr><td colspan="5" class="muted">Nenhuma conclusão sincronizada ainda.</td></tr>{% endfor %}</tbody></table></div><p class="muted">Os identificadores são pseudônimos técnicos; nomes de usuário serão integrados posteriormente.</p>{% endblock %}
