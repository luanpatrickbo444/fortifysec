NEXT_PUBLIC_SITE_URL=https://www.fortifysec.com.br
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SEU_ANON_KEY

# Somente no servidor/Vercel. Nunca exponha com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=SEU_SERVICE_ROLE_KEY
FORTIFY_INGEST_SECRET=troque-por-um-segredo-forte

# Um ou mais e-mails separados por vírgula. O primeiro acesso em /admin
# promove automaticamente o perfil usando a service role.
FORTIFY_ADMIN_EMAILS=admin@fortifysec.com.br

# Acronis Cyber Protect Cloud — server-side only
ACRONIS_CLIENT_ID=
ACRONIS_CLIENT_SECRET=
ACRONIS_DATACENTER_URL=

# Protege /api/cron/acronis-sync. Gere uma senha aleatória longa.
CRON_SECRET=
# Timezone exibido no portal (Mato Grosso por padrão).
FORTIFY_TIME_ZONE=America/Cuiaba
