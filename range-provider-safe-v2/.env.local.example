PORT=8787
PROVIDER_API_KEY=fortify-local-dev-change-me
PUBLIC_BASE_URL=http://127.0.0.1:8787
STATE_FILE=./data/state.json
LABS_FILE=./labs.local.json
MAX_TTL_MINUTES=240

# Local Docker Desktop backend
LOCAL_BIND_HOST=127.0.0.1
LOCAL_PUBLIC_HOST=127.0.0.1

# WireGuard is intentionally optional in local_docker mode.
WG_INTERFACE=wg0
WG_ENDPOINT=
WG_SERVER_PUBLIC_KEY=
WG_CLIENT_DNS=

# Google Cloud não é necessário no modo local.
GCP_PROJECT_ID=
