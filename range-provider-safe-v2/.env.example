PORT=8787
LISTEN_HOST=0.0.0.0
PUBLIC_BASE_URL=https://range-01.fortifysec.com.br
PROVIDER_API_KEY=troque-por-um-segredo-forte
RANGE_NODE_NAME=range-01

# Limites reais do node
MAX_ACTIVE_SESSIONS=100
MAX_SESSIONS_PER_USER=1
MAX_TTL_MINUTES=240

# Deve ser IGUAL ao valor de range_private_config.dynamic_flag_secret no Supabase
CTF_DYNAMIC_FLAG_SECRET=

STATE_FILE=./data/state.json
LABS_FILE=./labs.json

# WireGuard / GCP
WG_INTERFACE=wg0
WG_ENDPOINT=SEU_IP_OU_DOMINIO:51820
WG_SERVER_PUBLIC_KEY=
WG_CLIENT_DNS=
GCP_PROJECT_ID=
GCP_ZONE=southamerica-east1-b
GCP_NETWORK=global/networks/fortify-range
GCP_SUBNETWORK=regions/southamerica-east1/subnetworks/fortify-labs
GCP_MACHINE_TYPE_DEFAULT=e2-small
GCP_DISK_TYPE_DEFAULT=pd-balanced
GCP_DISK_SIZE_GB_DEFAULT=20
GCP_VM_NAME_PREFIX=fortify-lab
GCP_TARGET_TAG=fortify-lab
GCP_READY_TIMEOUT_SECONDS=180
